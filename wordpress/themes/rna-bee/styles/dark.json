{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "title": "RNA Bee Dark",
  "settings": {
    "color": {
      "palette": [
        {
          "slug": "base",
          "name": "Base",
          "color": "#111318"
        },
        {
          "slug": "contrast",
          "name": "Contrast",
          "color": "#B991E8"
        },
        {
          "slug": "accent-1",
          "name": "Accent 1",
          "color": "#191C22"
        },
        {
          "slug": "accent-2",
          "name": "Accent 2",
          "color": "#81CFC0"
        },
        {
          "slug": "accent-3",
          "name": "Accent 3",
          "color": "#F4F2EE"
        },
        {
          "slug": "accent-4",
          "name": "Accent 4",
          "color": "#AEBFFF"
        },
        {
          "slug": "accent-5",
          "name": "Accent 5",
          "color": "#1D2027"
        },
        {
          "slug": "accent-6",
          "name": "Accent 6",
          "color": "#FFFFFF26"
        }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--base)",
      "text": "var(--wp--preset--color--accent-4)"
    },
    "elements": {
      "heading": {
        "color": {
          "text": "var(--wp--preset--color--accent-3)"
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--contrast)"
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--contrast)",
          "text": "var(--wp--preset--color--accent-2)"
        }
      }
    }
  }
}