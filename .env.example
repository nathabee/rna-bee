# Public URL
PUBLIC_HOST=rna.nathabee.de

# Host-only ports. Apache on the VPS reverse-proxies to these.
WORDPRESS_HOST_PORT=8080
DJANGO_HOST_PORT=8000

# Django
DJANGO_SECRET_KEY=change-this-before-production
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=rna.nathabee.de,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://rna.nathabee.de
DJANGO_CORS_ALLOWED_ORIGINS=https://rna.nathabee.de

# PostgreSQL
POSTGRES_DB=rnabee
POSTGRES_USER=rnabee
POSTGRES_PASSWORD=change-this

# WordPress / MariaDB
MARIADB_DATABASE=wordpress
MARIADB_USER=wordpress
MARIADB_PASSWORD=change-this
MARIADB_ROOT_PASSWORD=change-this-too

# Redis / Celery
REDIS_URL=redis://redis:6379/0

# Shared simulation results
SIMULATION_RESULTS_DIR=/data/results
